{
  "name": "obraflow-backend",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Lucas Costa Soares",
    "url": "https://www.linkedin.com/in/lucas-costa-soares-10701b37b/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasC-Soares/Guess-Graph.git"
  },
  "bugs": {
    "url": "https://github.com/LucasC-Soares/Guess-Graph/issues"
  },
  "homepage": "https://github.com/LucasC-Soares/Guess-Graph#readme",
  "license": "MIT",
  "overrides": {
    "lodash": "4.18.1",
    "multer": "^2.3.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/database/migrate.js && node dist/main",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/**/*.ts",
      "!modules/**/*.spec.ts",
      "!modules/**/*.int-spec.ts",
      "!modules/**/*.e2e-spec.ts",
      "!modules/**/*.module.ts",
      "!modules/**/interfaces/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "cobertura"
    ],
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^8.57.1",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^29.5.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.8",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
